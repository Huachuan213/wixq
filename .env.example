# Optional API settings. The defaults are the verified production path.
WIXQ_API_BASE=https://api.zsxq.com
WIXQ_TOPICS_API_PATH=/v2/groups/{group_id}/topics
WIXQ_TOPICS_PAGE_SIZE=20
WIXQ_TOPICS_CURSOR_PARAM=end_time
WIXQ_API_VERSION=2.37.0
WIXQ_RETRY_ATTEMPTS=3
WIXQ_RETRY_BACKOFF_SECONDS=0.5

# Keep real authentication files outside version control.
WIXQ_SESSION_FILE=sessions/zsxq.json
